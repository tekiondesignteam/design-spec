#!/bin/sh
#
# Pre-commit guardrail for the shared design repo.
#
#   1. Blocks any commit that touches a read-only design-systems/ folder.
#   2. Auto-stamps the "Last updated" header on changed projects/<name>/*.md
#      files (and fills any lingering {{DESIGNER_NAME}}/{{DATE}} placeholders),
#      so artifacts stay current without anyone hand-editing dates.
#
# Install (from the repo root):
#   cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Bypass (maintainers only, when intentionally editing the design system):
#   git commit --no-verify

# --- 1. Block edits to the read-only design system -------------------------
blocked=$(git diff --cached --name-only --diff-filter=ACMRD -z \
  | tr '\0' '\n' \
  | grep -E '^design-systems/' )

if [ -n "$blocked" ]; then
  echo "✋  Commit blocked: this change touches a read-only design-systems/ folder."
  echo ""
  echo "    Design systems are the shared source of truth. Designers work only"
  echo "    inside their own projects/<name>/ folder."
  echo ""
  echo "    Offending files:"
  echo "$blocked" | sed 's/^/      - /'
  echo ""
  echo "    If you are a maintainer intentionally editing the design system,"
  echo "    bypass with:  git commit --no-verify"
  exit 1
fi

# --- 2. Auto-stamp project artifacts ---------------------------------------
today=$(date +%Y-%m-%d)
name=$(git config user.name)
[ -n "$name" ] || name=$(git config user.email | sed 's/@.*//')

git diff --cached --name-only --diff-filter=ACM -z \
  | tr '\0' '\n' \
  | grep -E '^projects/.*\.md$' \
  | while IFS= read -r f; do
      [ -f "$f" ] || continue
      grep -q '\*\*Last updated:\*\*' "$f" || continue
      tmp="$f.stamp.$$"
      # Refresh the "Last updated:" field to today; fill any leftover
      # DESIGNER_NAME / DATE placeholders with the committer + today.
      sed -E \
        -e "s|\{\{DESIGNER_NAME\}\}|${name}|g" \
        -e "s|\{\{DATE\}\}|${today}|g" \
        -e "s|(\*\*Last updated:\*\* ).*|\1${today}|" \
        "$f" > "$tmp" && mv "$tmp" "$f"
      # Re-stage so the stamped date is part of this commit.
      # Note: this stages the whole file — if you used `git add -p`, review first.
      git add "$f"
    done

exit 0
